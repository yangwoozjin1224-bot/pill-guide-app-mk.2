# 공공데이터포털(data.go.kr) 서비스 키
# https://www.data.go.kr 에서 「의약품 낱알식별정보」 검색 후 활용신청
# 파일 이름을 .env 로 바꾸세요. (Vite는 VITE_ 접두어 필요)
VITE_API_KEY=YOUR_SERVICE_KEY

# (선택) 관찰용/폴백 비전 LLM — OpenAI 호환 Chat Completions
# 특징 추출(이름 추측 금지) + DB 매칭 실패 시 폴백에 사용
VITE_VISION_LLM_KEY=
VITE_VISION_LLM_URL=https://api.openai.com/v1/chat/completions
VITE_VISION_LLM_MODEL=gpt-4o-mini

# Phase 1: 처방 목록(약봉투) 우선 매칭 최소 신뢰도 (0~1)
# 이 값 미만이면 전체 식약처 DB로 폴백합니다.
VITE_PRESCRIPTION_MATCH_MIN_CONF=0.45

# Phase 2: 실시간 품질 게이트 (네트워크/OCR 호출 전, 온디바이스)
# false 로 끄면 게이트를 건너뜁니다.
VITE_QUALITY_GATE_ENABLED=true
# Laplacian variance 하한 — 낮을수록 흐린 프레임 허용
VITE_QUALITY_BLUR_MIN=80
# 평균 밝기(0~255) 허용 범위
VITE_QUALITY_BRIGHT_MIN=45
VITE_QUALITY_BRIGHT_MAX=210
# 중앙 구도/피사체 최소 점수(0~1)
VITE_QUALITY_FRAMING_MIN=0.08
# 겹침 경고 soft-warn 기준(전경 비율)
VITE_QUALITY_OVERLAP_MAX_FILL=0.55

# Phase 4: 오인식 피드백 로컬 저장
# 최대 보관 건수 (localStorage)
VITE_FEEDBACK_MAX_ITEMS=100
# true면 사용자가 동의한 경우에만 축소 썸네일 저장 허용
# (동의 없이 원본 이미지를 서버에 영구 저장하면 안 됨)
VITE_FEEDBACK_ALLOW_IMAGE=true

# Phase 5: 조건부 다중 프레임 앙상블 (저신뢰도일 때만 추가 각도 요청)
VITE_ENSEMBLE_ENABLED=true
# 이 신뢰도 미만(또는 color_shape/prior 등)이면 추가 프레임 수집
VITE_ENSEMBLE_MIN_CONF=0.55
# 모을 프레임 수
VITE_ENSEMBLE_FRAMES=3
# 추가 프레임 대기 제한(ms) — 초과 시 현재까지 결과로 확정
VITE_ENSEMBLE_TIMEOUT_MS=8000
