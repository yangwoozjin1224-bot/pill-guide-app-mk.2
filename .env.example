# 공공데이터포털(data.go.kr) 서비스 키
# https://www.data.go.kr 에서 「의약품 낱알식별정보」 검색 후 활용신청
# 파일 이름을 .env 로 바꾸세요. (Vite는 VITE_ 접두어 필요)
VITE_API_KEY=YOUR_SERVICE_KEY

# (선택) 관찰용/폴백 비전 LLM — OpenAI 호환 Chat Completions
# 특징 추출(이름 추측 금지) + DB 매칭 실패 시 폴백에 사용
VITE_VISION_LLM_KEY=
VITE_VISION_LLM_URL=https://api.openai.com/v1/chat/completions
VITE_VISION_LLM_MODEL=gpt-4o-mini
